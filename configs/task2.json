    "epochs": 20,
    "batches_per_epoch": 4,
    "learning_rate": 0.01,
    "l2": 0.0001,
    "early_stopping_patience": 3,
    "clip_predictions": true
  },
  "model_dir": "../models/task2/rating_regressor"
}
