{
  "task": "task2",
  "train_path": "../data/task2/train.csv",
  "test_path": "../data/task2/test.csv",
  "sample_path": "../data/task2/sample_submission.csv",
  "output_dir": "../runs/task2",
  "seed": 5434,
  "params": {
    "spark_master": "local[*]",
